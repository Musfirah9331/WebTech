<!-- Cart modal (same behavior as index page) -->
<div id="cartModal" aria-hidden="true">
    <div class="cart-header">Cart <button id="cartCloseBtn" type="button">x</button></div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-footer">
        <div style="margin-bottom:8px">Total: <span id="cartTotal">PKR 0</span></div>
        <button id="checkoutBtn" class="checkoutBtn">Checkout</button>
    </div>
</div>

<style>
    .addToCartBtn { display:inline-block; padding:8px 12px; margin-top:8px; background:transparent; color:#000; border:1px solid #000; cursor:pointer; font-size:14px; }
    .cartToggle { position:relative; display:inline-block; }
    .cart-badge { background:#000; color:#fff; border:none; border-radius:50%; width:14px; height:14px; padding:0; font-size:10px; line-height:14px; position:absolute; top:-4px; right:-10px; display:none; text-align:center; box-sizing:border-box; box-shadow:0 1px 2px rgba(0,0,0,0.12); }
    #cartModal { position:fixed; right:20px; top:60px; width:360px; max-height:70vh; background:#fff; border:1px solid #ddd; box-shadow:0 6px 24px rgba(0,0,0,0.1); display:none; overflow:auto; z-index:9999; }
    #cartModal .cart-header { padding:12px; border-bottom:1px solid #eee; font-weight:600; display:flex; justify-content:space-between; align-items:center; }
    #cartCloseBtn { border:1px solid #ccc; background:#fff; cursor:pointer; width:28px; height:28px; line-height:24px; }
    #cartModal .cart-items { padding:12px }
    #cartModal .cart-item { display:flex; gap:8px; align-items:center; margin-bottom:10px }
    #cartModal .cart-item img { width:54px; height:54px; object-fit:cover; border:1px solid #eee }
    #cartModal .qty-controls { display:flex; gap:6px; align-items:center }
    #cartModal .qty-controls button { width:28px; height:28px; border:1px solid #ccc; background:#fff; cursor:pointer }
    #cartModal .cart-footer { padding:12px; border-top:1px solid #eee }
    #cartModal .checkoutBtn { display:block; width:100%; padding:10px; background:#000; color:#fff; border:none; cursor:pointer }
</style>

<script>
    (function(){
        const cartKey = 'lab_cart_v1';
        const IS_LOGGED_IN = <%= currentUser ? 'true' : 'false' %>;
        const cartCloseBtn = document.getElementById('cartCloseBtn');
        const cartCountEls = document.querySelectorAll('.cart-badge');
        const cartModal = document.getElementById('cartModal');
        const cartItemsEl = document.getElementById('cartItems');
        const cartTotalEl = document.getElementById('cartTotal');
        const checkoutBtn = document.getElementById('checkoutBtn');

        function loadCart(){ try{ return JSON.parse(localStorage.getItem(cartKey)) || {}; }catch(e){return {}} }
        function saveCart(cart){
            localStorage.setItem(cartKey, JSON.stringify(cart));
            updateBadge();
            if (IS_LOGGED_IN) {
                try {
                    fetch('/api/cart', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cart }) }).catch(()=>{});
                } catch(e){}
            }
        }
        function updateBadge(){ if(!cartCountEls) return; const cart = loadCart(); let qty=0; Object.values(cart).forEach(i=>qty+=i.qty||0); cartCountEls.forEach(el=>{ if(qty>0){ el.style.display='inline-block'; el.textContent = qty } else { el.style.display='none' } }); }
        function formatPrice(text){ const num = parseFloat((text||'').replace(/[^0-9\.]/g,''))||0; return num; }
        function renderCart(){ const cart = loadCart(); if(!cartItemsEl) return; cartItemsEl.innerHTML=''; let total=0; Object.keys(cart).forEach(key=>{ const item=cart[key]; const div=document.createElement('div'); div.className='cart-item'; div.innerHTML = `<img src="${item.img}" alt=""><div style="flex:1"><div style="font-size:13px">${item.title}</div><div style="font-size:13px;color:#666">PKR ${item.price.toLocaleString()}</div></div><div class="qty-controls"><button data-action="decr" data-id="${key}">-</button><div style="min-width:24px;text-align:center">${item.qty}</div><button data-action="incr" data-id="${key}">+</button></div>`; cartItemsEl.appendChild(div); total += item.price * item.qty; }); if(cartTotalEl) cartTotalEl.textContent = 'PKR ' + total.toLocaleString(); }

        function closeCart(){ if(cartModal) cartModal.style.display = 'none'; }

        document.addEventListener('click', function(e){
            if(e.target.matches('.addToCartBtn')){
                const card = e.target.closest('.card');
                const title = card.querySelector('.productTitle').textContent.trim();
                const priceText = card.querySelector('.productPrice').textContent.trim();
                const img = card.querySelector('img') ? card.querySelector('img').src : '';
                const price = formatPrice(priceText);
                const key = title.replace(/\s+/g,'_').toLowerCase();
                const cart = loadCart();
                if(!cart[key]) cart[key] = { title, price, img, qty:0 };
                cart[key].qty += 1;
                saveCart(cart);
                renderCart();
            }
            if(e.target.closest && e.target.closest('.cartToggle')){
                if(cartModal) cartModal.style.display = cartModal.style.display === 'block' ? 'none' : 'block';
                renderCart();
            }
            if(cartModal && cartModal.style.display === 'block' && !e.target.closest('#cartModal') && !e.target.closest('.cartToggle')){
                closeCart();
            }
            if(e.target.dataset && (e.target.dataset.action === 'incr' || e.target.dataset.action === 'decr')){
                const id = e.target.dataset.id; const action = e.target.dataset.action; const cart = loadCart(); if(cart[id]){ if(action==='incr') cart[id].qty +=1; else cart[id].qty = Math.max(0, cart[id].qty-1); if(cart[id].qty===0) delete cart[id]; saveCart(cart); renderCart(); }
            }
        });

        if (cartCloseBtn) cartCloseBtn.addEventListener('click', closeCart);
        document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeCart(); });
        if (checkoutBtn) checkoutBtn.addEventListener('click', function(){ window.location.href = '/checkout'; });
        // initial: if logged in, load server cart (server authoritative). For anonymous users keep local cart.
        if (IS_LOGGED_IN) {
            fetch('/api/cart').then(r=>r.json()).then(data=>{
                const serverCart = data && data.cart ? data.cart : {};
                try { localStorage.setItem(cartKey, JSON.stringify(serverCart)); }catch(e){}
                updateBadge(); renderCart();
            }).catch(()=>{ updateBadge(); renderCart(); });
        } else {
            updateBadge(); renderCart();
        }
    })();
</script>

<script>
    function toggleMenu() {
        const nav = document.getElementById('mobileNav');
        nav.classList.toggle('open');
    }

    function toggleSearchBar() {
        const searchContainer = document.getElementById('searchBarContainer');
        searchContainer.classList.toggle('active');
        if (searchContainer.classList.contains('active')) {
            const input = document.querySelector('.searchBarInput');
            if (input) input.focus();
        }
    }

    function toggleFilterPopup() {
        const filterPopup = document.getElementById('filterPopup');
        if (filterPopup.style.display === 'none') {
            filterPopup.style.display = 'block';
        } else {
            filterPopup.style.display = 'none';
        }
    }

    function filterByCategory(category) {
        const currentUrl = new URL(window.location);
        if (category === '') {
            currentUrl.searchParams.delete('category');
        } else {
            currentUrl.searchParams.set('category', category);
        }
        window.location.href = currentUrl.toString();
    }

    // Close search bar when clicking outside
    document.addEventListener('click', function(event) {
        const searchContainer = document.getElementById('searchBarContainer');
        const searchIcon = document.querySelector('.headerIcons a');
        if (searchContainer && searchIcon && !searchContainer.contains(event.target) && !searchIcon.contains(event.target)) {
            searchContainer.classList.remove('active');
        }
    });

    // Close filter popup when clicking outside
    document.addEventListener('click', function(event) {
        const filterPopup = document.getElementById('filterPopup');
        const filterBtn = document.querySelector('.filterIconBtn');
        if (filterPopup && filterBtn && !filterPopup.contains(event.target) && !filterBtn.contains(event.target)) {
            filterPopup.style.display = 'none';
        }
    });

    // Submit search on Enter
    document.addEventListener('keypress', function(event) {
        const searchInput = document.querySelector('.searchBarInput');
        if (searchInput && event.key === 'Enter' && searchInput.value.trim()) {
            searchInput.form.submit();
        }
    });

    // Close search bar on Escape
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            const searchContainer = document.getElementById('searchBarContainer');
            if (searchContainer) searchContainer.classList.remove('active');
            const filterPopup = document.getElementById('filterPopup');
            if (filterPopup) filterPopup.style.display = 'none';
        }
    });

    document.querySelectorAll('#mobileNav a').forEach(function(link) {
        link.addEventListener('click', function() {
            document.getElementById('mobileNav').classList.remove('open');
        });
    });
</script>

</body>
</html>