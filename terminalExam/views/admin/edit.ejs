<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Product - BATIK Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/batikClone.css">
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
<div class="adminWrapper" id="adminWrapper">

    <div class="adminSidebar" id="adminSidebar">
        <button type="button" class="sidebarToggleIn" onclick="toggleSidebar()" title="Toggle sidebar">
            <i class="fas fa-bars"></i>
        </button>
        <h2>BATIK ADMIN</h2>
        <a href="/admin"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/admin/add"><i class="fas fa-plus"></i> Add Product</a>
        <a href="/"><i class="fas fa-store"></i> View Store</a>
    </div>

    <div class="adminContent">
        <div class="adminTopBar">
            <button type="button" class="adminMenuBtn" onclick="toggleSidebar()" title="Toggle sidebar">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <div class="formCard">
            <h2>EDIT PRODUCT</h2>

            <form action="/admin/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">

                <div class="formGroup">
                    <label>Product Name</label>
                    <input type="text" name="name" value="<%= product.name %>" required>
                </div>

                <div class="formGroup">
                    <label>Price (PKR)</label>
                    <input type="number" name="price" value="<%= product.price %>" required>
                </div>

                <div class="formGroup">
                    <label>Category</label>
                    <select name="category" required>
                        <option value="New In"      <%= product.category === 'New In'      ? 'selected' : '' %>>New In</option>
                        <option value="Festive"     <%= product.category === 'Festive'     ? 'selected' : '' %>>Festive</option>
                        <option value="Lawn"        <%= product.category === 'Lawn'        ? 'selected' : '' %>>Lawn</option>
                        <option value="Luxe Pret"   <%= product.category === 'Luxe Pret'   ? 'selected' : '' %>>Luxe Pret</option>
                        <option value="BATIKstudio" <%= product.category === 'BATIKstudio' ? 'selected' : '' %>>BATIKstudio</option>
                    </select>
                </div>

                <div class="formGroup">
                    <label>Rating (1-5)</label>
                    <input type="number" name="rating" value="<%= product.rating %>" min="1" max="5" step="0.1" required>
                </div>

                <div class="formGroup">
                    <label>Stock</label>
                    <input type="number" name="stock" value="<%= product.stock %>" min="0" required>
                </div>

                <div class="formGroup">
                    <label>Current Image</label>
                    <img src="/<%= product.image %>" class="currentImg" alt="Current">
                    <label>Upload New Image (optional)</label>
                    <input type="file" name="image" accept="image/*">
                    <small style="color:#888; font-size:12px;">Leave empty to keep current image</small>
                </div>

                <div style="margin-top: 30px;">
                    <button type="submit" class="submitBtn">SAVE CHANGES</button>
                    <a href="/admin" class="cancelBtn">CANCEL</a>
                </div>

            </form>
        </div>
    </div>
</div>
<script>
    const adminSidebar = document.getElementById('adminSidebar');
    const adminWrapper = document.getElementById('adminWrapper');

    function toggleSidebar() {
        adminSidebar.classList.toggle('open');
        adminWrapper.classList.toggle('sidebar-open');
    }

    document.addEventListener('click', function(event) {
        const clickedMenuBtn = event.target.closest('.adminMenuBtn');
        const clickedSidebarBtn = event.target.closest('.sidebarToggleIn');
        if (!clickedMenuBtn && !clickedSidebarBtn && !adminSidebar.contains(event.target)) {
            adminSidebar.classList.remove('open');
            adminWrapper.classList.remove('sidebar-open');
        }
    });
</script>
</body>
</html>