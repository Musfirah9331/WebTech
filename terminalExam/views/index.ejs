        <button id="checkoutBtn" class="checkoutBtn">Checkout</button>
    </div>
</div>

<script>
    function toggleSearchBar() {
        const searchContainer = document.getElementById('searchBarContainer');
        if (searchContainer) {
            searchContainer.classList.toggle('active');
            if (searchContainer.classList.contains('active')) {
                const input = searchContainer.querySelector('.searchBarInput');
                if (input) input.focus();
            }
        }
    }

    function toggleMenu() {
        const nav = document.getElementById('mobileNav');
        if (nav) {
            nav.classList.toggle('open');
        }
    }
        // Cart logic
        (function(){
            const cartKey = 'lab_cart_v1';
            const cartCloseBtn = document.getElementById('cartCloseBtn');
            const cartCountEls = document.querySelectorAll('.cart-badge');
            const cartModal = document.getElementById('cartModal');
            const cartItemsEl = document.getElementById('cartItems');
            const cartTotalEl = document.getElementById('cartTotal');
            const checkoutBtn = document.getElementById('checkoutBtn');

            function loadCart(){
                try{ return JSON.parse(localStorage.getItem(cartKey)) || {}; }catch(e){return {}} }
            function saveCart(cart){ localStorage.setItem(cartKey, JSON.stringify(cart)); updateBadge(); }

            function updateBadge(){ if(!cartCountEls) return; const cart = loadCart(); let qty=0; Object.values(cart).forEach(i=>qty+=i.qty||0); cartCountEls.forEach(el=>{ if(qty>0){ el.style.display='inline-block'; el.textContent = qty } else { el.style.display='none' } }); }

            function formatPrice(text){ // assume PKR NNN or $ etc
                const num = parseFloat((text||'').replace(/[^0-9\.]/g,''))||0; return num;
            }

            function renderCart(){ const cart = loadCart(); cartItemsEl.innerHTML=''; let total=0; Object.keys(cart).forEach(key=>{ const item=cart[key]; const div=document.createElement('div'); div.className='cart-item'; div.innerHTML = `<img src="${item.img}" alt=""><div style="flex:1"><div style="font-size:13px">${item.title}</div><div style="font-size:13px;color:#666">PKR ${item.price.toLocaleString()}</div></div><div class="qty-controls"><button data-action="decr" data-id="${key}">-</button><div style="min-width:24px;text-align:center">${item.qty}</div><button data-action="incr" data-id="${key}">+</button></div>`; cartItemsEl.appendChild(div); total += item.price * item.qty; }); cartTotalEl.textContent = 'PKR ' + total.toLocaleString(); }

            function closeCart(){
                cartModal.style.display = 'none';
            }

            document.addEventListener('click', function(e){
                if(e.target.matches('.addToCartBtn')){
                    const card = e.target.closest('.card');
                    const title = card.querySelector('.productTitle').textContent.trim();
                    const priceText = card.querySelector('.productPrice').textContent.trim();
                    const img = card.querySelector('img') ? card.querySelector('img').src : '';
                    const price = formatPrice(priceText);
                    const key = title.replace(/\s+/g,'_').toLowerCase();
                    const cart = loadCart();
                    if(!cart[key]) cart[key] = { title, price, img, qty:0 };
                    cart[key].qty += 1;
                    saveCart(cart);
                    renderCart();
                }
                if(e.target.closest && e.target.closest('.cartToggle')){
                    cartModal.style.display = cartModal.style.display === 'block' ? 'none' : 'block';
                    renderCart();
                }
                if(cartModal.style.display === 'block' && !e.target.closest('#cartModal') && !e.target.closest('.cartToggle')){
                    closeCart();
                }
                if(e.target.dataset && (e.target.dataset.action === 'incr' || e.target.dataset.action === 'decr')){
                    const id = e.target.dataset.id; const action = e.target.dataset.action; const cart = loadCart(); if(cart[id]){ if(action==='incr') cart[id].qty +=1; else cart[id].qty = Math.max(0, cart[id].qty-1); if(cart[id].qty===0) delete cart[id]; saveCart(cart); renderCart(); }
                }
            });

            if (cartCloseBtn) {
                cartCloseBtn.addEventListener('click', closeCart);
            }

            document.addEventListener('keydown', function(e){
                if(e.key === 'Escape') closeCart();
            });

            checkoutBtn.addEventListener('click', function(){ window.location.href = '/checkout'; });

            // initial
            updateBadge(); renderCart();
        })();
</script>
