    <style>
    .addToCartBtn { display:inline-block; padding:8px 12px; margin-top:8px; background:transparent; color:#000; border:1px solid #000; cursor:pointer; font-size:14px; }
    .cartToggle { position:relative; display:inline-block; }
    .cart-badge { background:#000; color:#fff; border:none; border-radius:50%; width:14px; height:14px; padding:0; font-size:10px; line-height:14px; position:absolute; top:-4px; right:-10px; display:none; text-align:center; box-sizing:border-box; box-shadow:0 1px 2px rgba(0,0,0,0.12); }
    /* Cart modal */
    #cartModal { position:fixed; right:20px; top:60px; width:360px; max-height:70vh; background:#fff; border:1px solid #ddd; box-shadow:0 6px 24px rgba(0,0,0,0.1); display:none; overflow:auto; z-index:9999; }
    #cartModal .cart-header { padding:12px; border-bottom:1px solid #eee; font-weight:600; display:flex; justify-content:space-between; align-items:center; }
    #cartCloseBtn { border:1px solid #ccc; background:#fff; cursor:pointer; width:28px; height:28px; line-height:24px; }
    #cartModal .cart-items { padding:12px }
    #cartModal .cart-item { display:flex; gap:8px; align-items:center; margin-bottom:10px }
    #cartModal .cart-item img { width:54px; height:54px; object-fit:cover; border:1px solid #eee }
    #cartModal .qty-controls { display:flex; gap:6px; align-items:center }
    #cartModal .qty-controls button { width:28px; height:28px; border:1px solid #ccc; background:#fff; cursor:pointer }
    #cartModal .cart-footer { padding:12px; border-top:1px solid #eee }
    #cartModal .checkoutBtn { display:block; width:100%; padding:10px; background:#000; color:#fff; border:none; cursor:pointer }
    </style>
</head>
